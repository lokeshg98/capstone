      "id": "http-weekly-digest",
      "name": "Trigger Weekly Digest",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 300]
    }
  ],
  "connections": {
    "Every Friday 5pm": {
      "main": [
