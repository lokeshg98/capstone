# Copy to .env and fill in values. Never commit .env.

# --- Spring Boot ---
SPRING_PROFILES_ACTIVE=dev

# --- Database ---
DB_URL=jdbc:postgresql://localhost:5432/communitybot
DB_USERNAME=communitybot
DB_PASSWORD=communitybot

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT ---
# Generate with: openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_STRONG_BASE64_SECRET

# --- OAuth2 (register apps at console.cloud.google.com and github.com/settings/developers) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- App ---
FRONTEND_URL=http://localhost:3000

# --- MinIO ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=community-bot

# --- OpenAI ---
# Get key at: https://platform.openai.com/api-keys
# Models used: text-embedding-3-small (embeddings) + gpt-4o-mini (RAG chat)
OPENAI_API_KEY=sk-proj-REPLACE_ME

# --- Tavily (optional web search for Ask Bot multi-agent) ---
# When set, workspace admins can use web search tools from the Ask Bot panel.
# Leave blank to disable web search gracefully.
TAVILY_API_KEY=
